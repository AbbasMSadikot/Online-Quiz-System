{
  "name": "@online-quiz/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "node src/seed.js",
    "verify:tls": "node scripts/verify-tls.mjs",
    "benchmark:grading": "node --env-file=.env.test scripts/benchmark-grading.mjs",
    "test": "node --env-file=.env.test --test --test-concurrency=1"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^6.18.0",
    "supertest": "^7.1.4"
  }
}

