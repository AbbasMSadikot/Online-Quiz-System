DATABASE_URL="file:./dev.db"
AUTH_JWT_SECRET="replace-this-with-a-random-secret-at-least-32-characters"
PORT=3001
# Optional: set both values before `npm run db:seed` to provision an admin.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-private-password-at-least-8-characters-long
# Set both paths to enable HTTPS. The server enforces TLS 1.2 as the minimum.
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key
